# ============================================================
# RESQFOOD - Environment Variables Configuration
# ============================================================

# Database (Default: SQLite for local dev zero-config; PostgreSQL for Production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@ep-cold-lake-12345.us-east-2.aws.neon.tech/resqfood?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret
AUTH_SECRET="resqfood-production-secret-token-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Abstraction (options: local, mock, openai, gemini)
AI_PROVIDER="local"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Map Provider Abstraction (options: canvas-vector, maplibre, leaflet, osm)
NEXT_PUBLIC_MAP_PROVIDER="canvas-vector"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Storage Provider Abstraction (options: local, s3, r2)
STORAGE_PROVIDER="local"
S3_BUCKET_NAME="resqfood-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Notification Provider Abstraction (options: mock, resend, sendgrid, twilio)
EMAIL_PROVIDER="mock"
SMS_PROVIDER="mock"

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_ENABLE_3D_INTRO="true"
